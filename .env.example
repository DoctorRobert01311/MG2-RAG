# MG2-RAG configuration
# Copy this file to .env and replace every /path/to/... value.
# Every BaseConfig field can be overridden as MG2RAG_<FIELD_NAME_UPPERCASE>.

# -----------------------------------------------------------------------------
# Bundled fixed demo
# -----------------------------------------------------------------------------
DEMO_STAGE=all
DEMO_RUN_QA=false
DEMO_QA_MODE=llm

# -----------------------------------------------------------------------------
# OpenAI-compatible generation services
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-local
MG2RAG_LLM_NAME=your-text-model
MG2RAG_LLM_BASE_URL=http://127.0.0.1:8000/v1
MG2RAG_MLLM_NAME=your-multimodal-model
MG2RAG_MLLM_BASE_URL=http://127.0.0.1:8000/v1
MG2RAG_MAX_NEW_TOKENS=400
MG2RAG_NUM_GEN_CHOICES=1
MG2RAG_SEED=42
MG2RAG_TEMPERATURE=0.0
MG2RAG_TOP_P=1.0
MG2RAG_SAMPLING_TOP_K=20
MG2RAG_ENABLE_THINKING=false
MG2RAG_RESPONSE_FORMAT={"type":"json_object"}
MG2RAG_MAX_RETRY_ATTEMPTS=5

# -----------------------------------------------------------------------------
# Models and devices
# -----------------------------------------------------------------------------
MG2RAG_TOKENIZER_PATH=assets/Qwen2Tokenizer
MG2RAG_MULTIMODAL_EMBEDDING_MODEL_NAME=/path/to/BAAI/EVA-CLIP-8B
MG2RAG_CLIP_IMAGE_PROCESSOR_NAME=/path/to/clip-vit-large-patch14
MG2RAG_GROUNDING_MODEL_NAME=/path/to/sam3.pt
MG2RAG_IE_MODEL_NAME=/path/to/en_core_web_trf

MG2RAG_CLIP_DEVICE=0
MG2RAG_RETRIEVE_DEVICE=0
MG2RAG_PPR_DEVICE=0
MG2RAG_SAM3_DEVICE=1
MG2RAG_IENER_DEVICE=1

# -----------------------------------------------------------------------------
# Storage and preprocessing
# -----------------------------------------------------------------------------
MG2RAG_SAVE_DIR=outputs/impala_demo
MG2RAG_LOG_TO_FILE=false
MG2RAG_LOG_DIR=logs
MG2RAG_FORCE_OPENIE_FROM_SCRATCH=false
MG2RAG_FORCE_INDEX_FROM_SCRATCH=false
MG2RAG_RERANK_DSPY_FILE_PATH=null
MG2RAG_TEXT_PREPROCESSOR_CLASS_NAME=TextPreprocessor
MG2RAG_PREPROCESS_ENCODER_NAME=gpt-4o
MG2RAG_PREPROCESS_CHUNK_OVERLAP_TOKEN_SIZE=128
MG2RAG_PREPROCESS_CHUNK_MAX_TOKEN_SIZE=null
MG2RAG_SAVE_IENER=true
MG2RAG_SKIP_GRAPH=false

# -----------------------------------------------------------------------------
# Information extraction and visual grounding
# -----------------------------------------------------------------------------
MG2RAG_IE_BATCH_SIZE=4
MG2RAG_IENER_NUM_WORKS=1
MG2RAG_GROUNDING_MODEL_WORK_DIR=sam3_grounding
MG2RAG_GROUNDING_MODEL_PROMPT_BATCH_SIZE=8
MG2RAG_GROUNDING_DETECTION_THRESHOLD=0.5
MG2RAG_SAM3_NUM_WORKERS=1

# -----------------------------------------------------------------------------
# Unified EVA-CLIP embedding
# -----------------------------------------------------------------------------
MG2RAG_EMBEDDING_MODEL_NAME=nvidia/NV-Embed-v2
MG2RAG_EMBEDDING_BASE_URL=null
MG2RAG_EMBEDDING_BATCH_SIZE=16
MG2RAG_EMBEDDING_MAX_MODEL_LEN=45000
MG2RAG_EMBEDDING_RETURN_AS_NORMALIZED=true
MG2RAG_EMBEDDING_MODEL_DTYPE=auto
MG2RAG_MULTIMODAL_EMBEDDING_BATCH_SIZE=4
MG2RAG_MULTIMODAL_EMBEDDING_RETURN_AS_NORMALIZED=true
MG2RAG_MULTIMODAL_EMBEDDING_MAX_MODEL_LEN=77
MG2RAG_MULTIMODAL_EMBEDDING_MODEL_DTYPE=auto

# -----------------------------------------------------------------------------
# Graph construction
# -----------------------------------------------------------------------------
MG2RAG_IS_DIRECTED_GRAPH=false
MG2RAG_SYNONYMY_EDGE_TOPK=2047
MG2RAG_SYNONYMY_VISUAL_EDGE_TOPK=2047
MG2RAG_SYNONYMY_EDGE_QUERY_BATCH_SIZE=1000
MG2RAG_SYNONYMY_EDGE_KEY_BATCH_SIZE=10000
MG2RAG_SYNONYMY_EDGE_SIM_THRESHOLD=0.8
MG2RAG_SYNONYMY_VISUAL_EDGE_SIM_THRESHOLD=0.8

# -----------------------------------------------------------------------------
# InfoSeek retrieval configuration from Table 7 of the paper
# -----------------------------------------------------------------------------
MG2RAG_PPR_DAMPING=0.15
MG2RAG_PPR_BATCH_SIZE=4
MG2RAG_PPR_MAX_ITER=100
MG2RAG_PPR_TOLERANCE=0.000001
MG2RAG_CHUNK_NODE_WEIGHT=1.2
MG2RAG_IMG_NODE_WEIGHT=0.5
MG2RAG_TEXT_BRANCH_WEIGHT=0.1
MG2RAG_VISUAL_BRANCH_WEIGHT=1.0

# Activated seeds from textual queries
MG2RAG_TEXT_CHUNK_TOP_K=200
MG2RAG_TEXT_SENTENCE_TOP_K=3
MG2RAG_TEXT_IMG_TOP_K=2
MG2RAG_TEXT_SUBIMG_TOP_K=3
MG2RAG_TEXT_ENTITY_TOP_K=10

# Activated seeds from visual queries
MG2RAG_VISUAL_CHUNK_TOP_K=200
MG2RAG_VISUAL_SENTENCE_TOP_K=60
MG2RAG_VISUAL_IMG_TOP_K=1
MG2RAG_VISUAL_SUBIMG_TOP_K=5
MG2RAG_VISUAL_ENTITY_TOP_K=10

MG2RAG_RETRIEVAL_TOP_K=10

# -----------------------------------------------------------------------------
# QA and optional experiment metadata
# -----------------------------------------------------------------------------
MG2RAG_MAX_QA_STEPS=1
MG2RAG_QA_TOP_K=3
MG2RAG_QA_CONTEXT_MAX_LEN=24000
MG2RAG_DATASET=null
MG2RAG_GRAPH_TYPE=facts_and_sim_passage_node_unidirectional
MG2RAG_CORPUS_LEN=null

# Optional Azure-compatible endpoints
MG2RAG_AZURE_ENDPOINT=null
MG2RAG_AZURE_EMBEDDING_ENDPOINT=null
